{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blade-account-card",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-09-21",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bac-db",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE"
    }
  ]
}